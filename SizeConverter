        function convertTops() {
            const input = document.getElementById('tops-input').value.trim().toUpperCase();
            const fromRegion = document.getElementById('tops-from').value;
            const gender = document.getElementById('tops-gender').value;
            const resultsDiv = document.getElementById('tops-results');
            const outputDiv = document.getElementById('tops-output');
            
            if (!input) return;
            
            let results = [];
            let inputValue = isNaN(input) ? input : parseFloat(input);
            
            // Find the equivalent letter size from the input
            let letterSize = '';
            if (sizeData.tops[gender][fromRegion].hasOwnProperty(inputValue)) {
                letterSize = sizeData.tops[gender][fromRegion][inputValue];
            } else {
                return; // Size not found
            }
            
            // Convert to all other regions
            Object.keys(sizeData.tops[gender]).forEach(region => {
                if (region !== fromRegion) {
                    Object.keys(sizeData.tops[gender][region]).forEach(size => {
                        if (sizeData.tops[gender][region][size] === letterSize) {
                            const regionName = {
                                'eu': '🇪🇺 Europe',
                                'us': '🇺🇸 United States',
                                'uk': '🇬🇧 United Kingdom',
                                'international': '🌍 International'
                            }[region];
                            results.push(`<div class="flex justify-between items-center"><span class="font-medium text-lg">${regionName}:</span><span class="text-2xl font-bold text-indigo-600">${size}</span></div>`);
                        }
                    });
                }
            });
            
            outputDiv.innerHTML = results.join('');
            resultsDiv.classList.remove('hidden');
            resultsDiv.classList.add('result-animation');
        }

